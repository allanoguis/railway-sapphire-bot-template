DISCORD_TOKEN=replace-with-your-discord-bot-token
# Default command cooldown: per user, one use every 5 seconds.
COMMAND_COOLDOWN_DELAY_MS=5000
COMMAND_COOLDOWN_LIMIT=1
PORT=3000
# Railway: set this to a reference to the Postgres service's DATABASE_URL.
# Local development: use a PostgreSQL connection URL. Do not commit credentials.
DATABASE_URL=
# Required with DATABASE_URL to enable encrypted per-user Torn API pairing.
# Generate a random 32-byte key and provide its 64-character hexadecimal form.
TORN_ENCRYPTION_KEY=6be642c8a1010828ebb11ba4ae3f874e4ac31f319b5fcff76ef8c9445cefb7be
# Discord channel ID where /torn faction may publish public faction details.
TORN_FACTION_CHANNEL_ID=1569971459571585024
# Optional website: configure all three together, with DATABASE_URL and TORN_ENCRYPTION_KEY.
# Use an HTTPS origin in production; HTTP is allowed only for localhost development.
WEBSITE_ORIGIN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
