DISCORD_TOKEN=replace-with-your-discord-bot-token
# Default command cooldown: per user, one use every 5 seconds.
COMMAND_COOLDOWN_DELAY_MS=5000
COMMAND_COOLDOWN_LIMIT=1
PORT=3000
# Railway: set this to a reference to the Postgres service's DATABASE_URL.
# Local development: use a PostgreSQL connection URL. Do not commit credentials.
DATABASE_URL=
# Optional bot-owned Torn API key for public player ID lookups.
TORN_API_KEY=
# Required with DATABASE_URL to enable encrypted per-user Torn account linking.
# Generate a random 32-byte key and provide its 64-character hexadecimal form.
TORN_ENCRYPTION_KEY=
