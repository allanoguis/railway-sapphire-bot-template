{
	"main": "dist/index.js",
	"dependencies": {
		"@sapphire/framework": "^5.5.1",
		"@sapphire/plugin-logger": "^4.1.0",
		"colorette": "^2.0.19",
		"discord.js": "^14.28.1",
		"dotenv": "^18.0.10",
		"tslib": "^2.5.0"
	},
	"devDependencies": {
		"@sapphire/decorators": "^6.0.0",
		"@sapphire/eslint-config": "^5.0.6",
		"@sapphire/prettier-config": "^1.4.5",
		"@sapphire/ts-config": "^5.0.3",
		"@types/node": "^24.19.2",
		"eslint": "^8.57.1",
		"prettier": "^2.8.4",
		"typescript": "^5.9.3"
	},
	"scripts": {
		"build": "tsc",
		"watch": "tsc -w",
		"start": "node dist/index.js",
		"dev": "npm run build && npm run start",
		"watch:start": "tsc-watch --onSuccess \"npm run start\"",
