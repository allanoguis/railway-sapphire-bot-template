{
	"name": "token-discord-bot-template",
	"packageManager": "pnpm@7.33.7",
	"main": "dist/index.js",
	"dependencies": {
		"@sapphire/framework": "^5.5.1",
		"@sapphire/plugin-logger": "^4.1.0",
		"colorette": "^2.0.19",
		"discord.js": "^14.28.1",
		"dotenv": "^18.0.10",
		"pg": "^8.23.1",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"tslib": "^2.5.0"
	},
	"devDependencies": {
		"@sapphire/decorators": "^6.0.0",
		"@sapphire/eslint-config": "^5.0.6",
		"@sapphire/prettier-config": "^1.4.5",
		"@sapphire/ts-config": "^5.0.3",
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"@types/react": "18.3.0",
		"@types/react-dom": "18.3.0",
		"@vitejs/plugin-react": "4.7.0",
		"eslint": "^8.57.1",
		"prettier": "^2.8.4",
		"typescript": "^5.9.3",
		"vite": "6.4.6"
	},
	"scripts": {
		"build": "tsc && tsc -p web/tsconfig.json --noEmit && vite build web --config web/vite.config.ts",
		"watch": "tsc -w",
		"start": "node dist/index.js",
		"dev": "npm run build && npm run start",
		"test": "npm run build && node --test",
		"watch:start": "tsc-watch --onSuccess \"npm run start\"",
		"format": "prettier --write \"src/\"",
		"lint": "prettier --check . && eslint src/ --ext .js,.ts"
	}
}
